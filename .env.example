# Digi-IP Hub — example configuration only. Never commit production secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_SSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=https://digi-ip-hub.netlify.app
ANALYTICS_SALT=replace-with-at-least-32-random-characters
WORKER_SECRET=replace-with-at-least-32-random-characters
# Base64 encoding of exactly 32 random bytes, e.g. openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Commercial pilot
NEXT_PUBLIC_PRODUCT_NAME=Digi-IP Hub
NEXT_PUBLIC_SELLER_NAME=TophComm Systems
NEXT_PUBLIC_PRIMARY_PAYMENT=GCash
NEXT_PUBLIC_SECONDARY_PAYMENT=Maya

# Add merchant credentials only after an approved GCash-capable payment provider is selected.
# Never place private merchant credentials in NEXT_PUBLIC_* variables.
