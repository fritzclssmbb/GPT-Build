# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fs_cards
# Keep true in production unless your managed database explicitly requires otherwise.
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication: minimum 32 characters, unique per environment.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Public origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics privacy salt: long random value, unique per environment.
ANALYTICS_SALT=replace-with-a-long-random-analytics-salt

# Internal webhook worker authorization: long random value.
WORKER_SECRET=replace-with-a-long-random-worker-secret
